{% assign media = include.media %}
{% if media %}
  <div class="portfolio-media{% if media.fit == 'contain' %} portfolio-media-contain{% endif %}{% if media.type == 'gallery' %} portfolio-media-gallery{% endif %}">
    {% if media.type == 'gallery' %}
      <div class="portfolio-rollout-grid">
        {% for item in media.items %}
          <figure class="portfolio-rollout">
            <img src="{{ item.src | relative_url }}" alt="{{ item.alt }}" loading="lazy" data-zoomable>
            {% if item.label %}
              <figcaption>{{ item.label }}</figcaption>
            {% endif %}
          </figure>
        {% endfor %}
      </div>
    {% elsif media.type == 'youtube' %}
      <div
        class="portfolio-youtube"
        data-youtube-id="{{ media.youtube_id }}"
        data-youtube-title="{{ include.title | escape }}"
      >
        <img class="portfolio-youtube-poster" src="{{ media.poster | relative_url }}" alt="{{ media.alt }}" loading="lazy">
        <button class="portfolio-youtube-load" type="button" aria-label="Play {{ include.title }} video">
          <i class="fa-brands fa-youtube" aria-hidden="true"></i>
          <span>Play video</span>
        </button>
        <span class="portfolio-motion-label"><i class="fa-solid fa-volume-xmark" aria-hidden="true"></i> Autoplays muted</span>
      </div>
    {% elsif media.type == 'video' %}
      <video
        class="portfolio-video"
        muted
        loop
        playsinline
        preload="none"
        poster="{{ media.poster | relative_url }}"
        aria-label="{{ media.alt }}"
      >
        <source data-src="{{ media.src | relative_url }}" type="video/mp4">
      </video>
      <button class="portfolio-video-toggle" type="button" aria-label="Pause video preview">
        <i class="fa-solid fa-pause" aria-hidden="true"></i>
      </button>
      <button
        class="portfolio-media-expand"
        type="button"
        data-video-expand="{{ media.src | relative_url }}"
        data-video-poster="{{ media.poster | relative_url }}"
        data-media-title="{{ include.title | escape }}"
        aria-label="Expand {{ include.title }} video"
      >
        <i class="fa-solid fa-expand" aria-hidden="true"></i><span>Expand</span>
      </button>
    {% else %}
      <img src="{{ media.src | relative_url }}" alt="{{ media.alt }}" loading="lazy" data-zoomable>
      <button class="portfolio-media-expand" type="button" data-image-expand aria-label="Enlarge {{ include.title }} image">
        <i class="fa-solid fa-expand" aria-hidden="true"></i><span>Enlarge</span>
      </button>
    {% endif %}
  </div>
{% endif %}
