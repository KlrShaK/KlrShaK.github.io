{% assign media = include.media %}
{% if media %}
  <div class="portfolio-media">
    {% if media.type == 'youtube' %}
      <div
        class="portfolio-youtube"
        data-youtube-id="{{ media.youtube_id }}"
        data-youtube-title="{{ include.title | escape }}"
      >
        <img class="portfolio-youtube-poster" src="{{ media.poster | relative_url }}" alt="{{ media.alt }}" loading="lazy">
        <button class="portfolio-youtube-load" type="button" aria-label="Play {{ include.title }} video">
          <i class="fa-brands fa-youtube" aria-hidden="true"></i>
          <span>Play video</span>
        </button>
        <span class="portfolio-motion-label"><i class="fa-solid fa-volume-xmark" aria-hidden="true"></i> Autoplays muted</span>
      </div>
    {% elsif media.type == 'video' %}
      <video
        class="portfolio-video"
        muted
        loop
        playsinline
        preload="none"
        poster="{{ media.poster | relative_url }}"
        aria-label="{{ media.alt }}"
      >
        <source data-src="{{ media.src | relative_url }}" type="video/mp4">
      </video>
      <button class="portfolio-video-toggle" type="button" aria-label="Pause video preview">
        <i class="fa-solid fa-pause" aria-hidden="true"></i>
      </button>
      <span class="portfolio-motion-label"><i class="fa-solid fa-circle-play" aria-hidden="true"></i> Live preview</span>
    {% else %}
      <img src="{{ media.src | relative_url }}" alt="{{ media.alt }}" loading="lazy">
    {% endif %}
  </div>
{% endif %}
